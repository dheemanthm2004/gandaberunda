# Telegram credentials (required)
TELEGRAM_BOT_TOKEN=<your_bot_token_here>
TELEGRAM_CHAT_ID=<your_chat_id_here>

# Optional: send a Telegram alert when monitoring itself fails (set to 1 to enable)
NOTIFY_ON_FAILURE=0

# Request settings
REQUEST_TIMEOUT=20
MAX_RETRIES=3

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Dry-run: set to 1 to skip sending real Telegram messages
DRY_RUN=0

# Disable individual websites (set to 0 to disable)
ENABLE_STORE=1
ENABLE_IN=1

# State file path (relative to project root)
STATE_FILE=state.json
